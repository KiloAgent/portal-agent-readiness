{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "skills/portal-agent-readiness/scripts/**/*.ts",
    "skills/portal-agent-readiness/evals/**/*.ts",
    "tests/**/*.ts"
  ]
}
