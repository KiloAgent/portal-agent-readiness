{
  "name": "portal-agent-readiness",
  "version": "0.1.0",
  "description": "Score how automatable one portal or web tool is, pick a route, and draft a vendor access message.",
  "type": "module",
  "license": "MIT",
  "author": "KiloAgent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiloAgent/portal-agent-readiness.git"
  },
  "homepage": "https://www.kiloagent.com/tools/portal-check",
  "bugs": {
    "url": "https://github.com/KiloAgent/portal-agent-readiness/issues"
  },
  "keywords": [
    "portal",
    "readiness",
    "agent",
    "scoring",
    "rubric"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "vitest run skills/portal-agent-readiness/evals"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
